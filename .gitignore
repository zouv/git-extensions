# 环境变量（真实值绝不提交；样例 .env.example 入库）
.env
.env.*
!.env.example

# 运行时产物（PID / 日志 / 临时文件，manager.sh 与测试写入）
.runtime/
*.log

# IDE / 系统
.idea/
.vscode/
.vs/
*.swp
.DS_Store
Thumbs.db

# 前端
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# AI 工具的本地会话 / 个人设置（项目共享的 .claude/settings.json 与 skills 要入库）
.claude/settings.local.json
.claude/worktrees/
.codex/
.opencode/
